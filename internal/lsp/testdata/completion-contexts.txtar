-- in.journal --
account expenses:food
account expenses:taxi
account assets:cash

payee Grocery Store
payee Coffee Shop

commodity USD

tag client
tag project

2024-01-01 Grocery Store
    ; client:acme
    ; project:alpha
    expenses:food  $50
    expenses:taxi  $30
    assets:cash

^
2024-01-02 *
    ^
    expenses:^food  $50
    expenses:food  $^50
    expenses:food  ^
    expenses:food  U^SD
    expenses:food  $5^0
    expenses:food  $50 @^ 1.5
    * expenses:f^ood  $50
    (expenses:f^ood)  $50
    expenses:food  ; client:^x
    expenses:food  ; client: ac^me
    ; a:b, client:ac^
    ; url:https://exa^mple
    ; a:b:c, cli^ent:x
    ; groc^eries

2024-01-03 * (123) gro^cer
2024-01-03=2024-01-04 cof^fee
2024-01-03 "gro^cery"
2024-01-03 acme | no^te
2024-01-03 acme|note x^y
2024-01-03 ; cli^
2024-01-03^

account expenses:food
    no^te ignore

account expenses:food
    note: x

    no^te foo

account expenses:taxi
    note: x
   
    no^te foo

~ monthly^ budget


2024-01-15 Grocery
    expenses:food  $50
    expenses:taxi  $30
    assets:cash

2024-01-16 ^
    expenses:f^ood  $5
    assets:cash

