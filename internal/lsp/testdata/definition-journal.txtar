-- in.journal --
account ex^penses:food
account assets:checking
account expenses:food
  alias foo^d
alias fo^od = expenses:food
alias food = expenses:fo^od
account untracked
    no^te ignore

commodity ^$
    format 1,000.00

payee Grocery^ Store

^2024-01-15 Grocery^ Store ; no^te
    ^expenses:food^  $5^0
    expenses:food  ^$50
    assets:checking  = ^$30
    assets:cash  100.00 E^UR

2024-01-16 Another^ Store
    expenses:food  $50
    assets:cash  100.00 E^UR
    assets:checking  $30 @ ^$1.5

2024-01-17 продукти
    expenses:food  $10
    assets:cash

2024-01-18 прод^укти
    expenses:food  $20
    assets:ca^sh

