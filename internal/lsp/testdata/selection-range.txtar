-- in.journal --
; file co^mment
; ta^g:file

account expenses:^food
  alias super^market
commodity ^$
payee Grocery ^Store
payee "Quoted ^Payee"

2024-^01-15 ^* ^(cafe) Grocery ^Store | lu^nch ; ta^g:v1
    ; header comment tag:^h1
    expenses:^food:cafe  $12.50  ; discount tag:d1
    assets:^cash
    (virtual:un^balanced)  $5
    expenses:food:cafe  ^$12.50  ; discount tag:d1
    expenses:food:cafe  $12.^50  ; discount tag:d1
    expenses:food:cafe  $12.50  ; discount ^tag:d1
    expenses:food  50 EU^R @ 1.2 USD
    expenses:food  50 EUR @ ^1.2 USD
    assets:checking  10 USD = ^20 USD

2024-01-16 ^Grocery
    expenses:food  50 ^EUR
    ca^sh  $5

~ monthly  Gro^cery
    expenses:food  10 ^EUR

~ every ^week from 2024-01-^01 to 2024-0^2-01 ; note
    expenses:food  10 EUR

= ex^pr
    expenses:food  10 EUR

alias expenses:ca^fe = expenses:food:restaurant
tag na^me
D 1 U^SD
P 2024-01-20 12:^00:00 EUR 1.^2 USD
C 1 EUR = 1.^1 USD

payee Ка^фе

^
2024-01-17 t
    assets:cash
^

