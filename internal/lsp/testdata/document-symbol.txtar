-- in.journal --
account expenses:food
account expenses:taxi
account assets:cash

2024-01-15 Grocery Store ; project:work
    expenses:food  $50
    assets:cash  $-50

2024-01-16 * Coffee Shop | cappuccino
    expenses:taxi  $4
    assets:cash  $-4

payee Grocery Store
payee Coffee Shop

commodity USD
commodity EUR

tag project
tag client

~ monthly
    expenses:food  $10

= expenses:food
    expenses:food  $-1
^

