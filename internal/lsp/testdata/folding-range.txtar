-- in.journal --
account assets:cash
  type A
  note savings
  ; indented comment

; block one
; block one line two

comment big
some ignored text
end comment

apply tag work
2024-01-01 t
  expenses:food  $10
  assets:cash
end tag

2024-01-01 multi
  expenses:food  $10
  assets:cash  $-10

2024-01-01 single
  expenses:food  $10

2024-01-02 ~ monthly
  expenses:food  $10
  expenses:something  $10
  assets:cash  $-20

= expr
    expenses:food  $10
    assets:cash  $-10
^

-- expect --
1-3 region
5-6 comment
8-10 comment
12-16 region
14-15 region
19-20 region
26-28 region
31-32 region
