-- in.journal --
account expenses:food
account expenses:food  ; note

alias old = new
alias old = new  ; alias note

payee Some Store
payee Some Store  ; payee note

tag foo
tag foo  ; tag note

year 2024
year 2024  ; year note

Y 2024
Y 2024  ; Y note

apply account expenses
end apply
apply account expenses  ; apply note
end apply  ; end note

apply tag hashtag
end apply
apply tag hashtag  ; apply tag note
end apply  ; end note

apply fixed CAD $0.90
end apply
apply fixed CAD $0.90  ; apply fixed note
end apply  ; end note

N ignored
N ignored  ; N note
N $
N $  ; N dollar note

D $1,000.00
D $1,000.00  ; D note

P 2024-01-15 USD 1.05
P 2024-01-15 USD 1.05  ; P note
P 2024-01-01 12:00:00 USD 40.50
P 2024-01-01 12:00:00 USD 40.50  ; P time note

C 100 USD = 90 EUR
C 100 USD = 90 EUR  ; C note

decimal-mark .
decimal-mark .  ; decimal note

include foo.journal
include foo.journal  ; include note

commodity USD
commodity USD  ; commodity note

commodity INR
  format INR 1,00,00,000.00
commodity INR  ; commodity INR note
  format INR 1,00,00,000.00

commodity 1,000.00 UAH
commodity 1,000.00 UAH  ; commodity amount note
commodity UAH
  format 1 000.00 UAH
commodity UAH  ; commodity UAH note
  format 1 000.00 UAH

