-- in.journal --
account expenses:fo^od
account assets:cash
  alias check^ing
alias fo^od = expenses:food
alias food = expenses:fo^od
commodity E^UR
payee Gro^cery Store
tag cli^ent

^2024-01-15 Gro^cery Store ; proj^ect:ho^me
    expenses:food  ^$50^.00 @ ^$1.5
    assets:checking  $5^0.00 @ $1.5
    assets:cash  = ^$30
    ; cl^ient:acme
    ; completed:^

2024-01-15 Market
    expenses:food  $5
    assets:cash  $-5

2024-01-16 Grocery Store ; project:wo^rk
    expenses:food  1.000,00 E^UR
    assets:cash  -1.000,0^0 EUR

2024-01-17 прод^укти
    expenses:fo^od  $10
    assets:ca^sh

^
~ monthly
    expenses:fo^od  $1
    assets:cash

= expenses:food > 100
    assets:ca^sh  $-1

