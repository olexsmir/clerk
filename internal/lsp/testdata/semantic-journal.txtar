2024-01-15 t
    a  $10
    b  $-10

2024-01-15 * (CODE) Cafe | lunch ; weekly treat
    ; header note
    expenses:food:cafe    $12.50
    expenses:food         $-2.50  ; discount
    assets:cash
    [virtual:budget]      $20
    (virtual:unbalanced)  $5
    assets:checking       50 = 100
    assets:savings        10 == 100
    assets:brokerage      5 := 100
    ; continuation comment

2024-01-16 ! todo  ; inline note
    expenses:rent
    assets:checking  $800

2024-01-17 * done
    a  $1 = $100
    b  $2 == $100
    c  $3 =* $100
    d  $4 ==* $100
    e  $5 := $100

