-- in.journal --
account Expenses:Food
  alias food

account Assets:Bank
  alias bank

alias cash = Assets:Cash

2026-01-15 * "Lunch"
  food      $10
  Assets:Cash

2026-01-16 * "Dinner"
  Expenses:Food      $15
  cash

-- expect --
in.journal:11:3: undeclared-account: undeclared account: Assets:Cash
