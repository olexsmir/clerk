-- input --
account expenses:food
  type X
  note grocery shopping  ; what we spend
  alias food

account assets:bank
  type asset
  # hash comment
  payee ^store$
  alias bank
  type A  ; duplicate type
  alias

-- expect --
Journal
  AccountDirective j:1:1-6:0
