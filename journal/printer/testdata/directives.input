; Directives
account Assets:Cash ; cash account
commodity $
commodity UAH
commodity 1000.00 USD
commodity $1000.00
commodity 1,000.00 UAH
include ./other.journal
include ../one../another.journal
alias Assets:Checking = Assets:Cash
payee "Test Payee"
tag "important"
tag something-else
year 2026
decimal-mark ,

; Market price
P 2026/01/15 12:00:00 GOOG $150.00

; Conversion
C 100.00$ = 85.00€  ; test comment

; Default commodity
D $1,000.00

; N directive
N $

; Apply/end
apply account Expenses
end

; Comment block
comment
Some notes about the file
end comment
