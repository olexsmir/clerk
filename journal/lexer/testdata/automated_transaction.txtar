-- input --
= ^income
    (liabilities:tax)  *.33

= expenses:gifts
    budget:gifts  (amount * -1)
-- expect --
EQ           "="                  1:1-1:2
WHITESPACE   " "                  1:2-1:3
TEXT         "^income"            1:3-2:0
NEWLINE      "\n"                 2:0-2:1
INDENT       "    "               2:1-2:5
LPAREN       "("                  2:5-2:6
TEXT         "liabilities"        2:6-2:17
COLON        ":"                  2:17-2:18
TEXT         "tax"                2:18-2:21
RPAREN       ")"                  2:21-2:22
WHITESPACE   "  "                 2:22-2:24
STAR         "*"                  2:24-2:25
DECIMAL      ".33"                2:25-3:0
NEWLINE      "\n"                 3:0-4:0
NEWLINE      "\n"                 4:0-4:1
EQ           "="                  4:1-4:2
WHITESPACE   " "                  4:2-4:3
TEXT         "expenses:gifts"     4:3-5:0
NEWLINE      "\n"                 5:0-5:1
INDENT       "    "               5:1-5:5
TEXT         "budget"             5:5-5:11
COLON        ":"                  5:11-5:12
TEXT         "gifts"              5:12-5:17
WHITESPACE   "  "                 5:17-5:19
PARENEXPR    "(amount * -1)"      5:19-6:0
NEWLINE      "\n"                 6:0-6:1
EOF          ""                   6:1-6:1
